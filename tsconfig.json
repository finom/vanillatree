{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals"],
    "paths": { "vanillatree": ["./src/vanillatree.ts"] }
  },
  "include": ["src", "test"],
  // a user's files, checked against the packed tarball by check-dist
  "exclude": ["test/types"]
}
